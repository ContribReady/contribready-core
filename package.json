{
  "name": "@contribready/core",
  "version": "0.1.0",
  "description": "Deterministic contributor-readiness analysis engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "SUPPORT.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "assets/banner.svg"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContribReady/contribready-core.git"
  },
  "homepage": "https://github.com/ContribReady/contribready-core#readme",
  "bugs": {
    "url": "https://github.com/ContribReady/contribready-core/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "verify": "npm run lint && npm test && npm run pack:check"
  },
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
